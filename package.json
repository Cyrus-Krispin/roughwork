{
  "name": "strata-ai",
  "productName": "Strata AI",
  "version": "0.1.0",
  "description": "An adaptive Socratic learning partner that finds the edge of your understanding.",
  "main": ".webpack/main",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --platform=darwin --arch=arm64",
    "package:e2e": "STRATA_E2E_FAKE_PROVIDER=1 electron-forge package --platform=darwin --arch=arm64",
    "make": "electron-forge make --platform=darwin --arch=arm64",
    "make:from-package": "electron-forge make --skip-package --platform=darwin --arch=arm64",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verify:source",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:packaged-flow": "node scripts/verify-packaged-flow.mjs",
    "verify:packaged-onboarding": "node scripts/verify-packaged-flow.mjs --onboarding",
    "verify:source": "node scripts/verify-source.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "learning",
    "socratic",
    "electron"
  ],
  "author": "Cyrus",
  "license": "UNLICENSED",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "1.0.1",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "electron": "44.0.0",
    "eslint": "10.9.1",
    "fork-ts-checker-webpack-plugin": "7.3.0",
    "node-loader": "2.1.0",
    "plist": "3.1.1",
    "prettier": "3.9.6",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
