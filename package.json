{
  "name": "think-edge",
  "productName": "ThinkEdge",
  "version": "0.0.0",
  "description": "An adaptive Socratic learning partner that finds the edge of your understanding.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "learning",
    "socratic",
    "electron"
  ],
  "author": "Cyrus",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "1.0.1",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "6.11.0",
    "electron": "44.0.0",
    "eslint": "10.9.1",
    "fork-ts-checker-webpack-plugin": "7.3.0",
    "node-loader": "2.1.0",
    "prettier": "3.9.6",
    "style-loader": "3.3.4",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
